
# Practical 4: K-Means Clustering

# 1. Import required libraries
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns

from sklearn.cluster import KMeans
from sklearn.metrics import confusion_matrix, accuracy_score
from sklearn.preprocessing import LabelEncoder
from scipy.stats import mode

# 2. Load the Iris dataset
data = pd.read_csv("Iris.csv")
print(data.head())

# 3. Remove unnecessary columns
X = data.drop(["Id", "Species"], axis=1)

# 4. Use Elbow Method to find optimal clusters
wcss = []

for i in range(1, 11):
    kmeans = KMeans(
        n_clusters=i,
        init="k-means++",
        random_state=42,
        n_init=10
    )
    kmeans.fit(X)
    wcss.append(kmeans.inertia_)

# 5. Plot the Elbow graph
plt.plot(range(1, 11), wcss, marker="o")
plt.title("Elbow Method")
plt.xlabel("Number of Clusters")
plt.ylabel("WCSS")
plt.grid(True)
plt.show()

# 6. Apply K-Means with 3 clusters
kmeans = KMeans(
    n_clusters=3,
    init="k-means++",
    random_state=42,
    n_init=10
)

y_kmeans = kmeans.fit_predict(X)

# 7. Add cluster labels to the dataset
data["Cluster"] = y_kmeans
print(data.head())

# 8. Visualize the clusters
sns.scatterplot(
    x="PetalLengthCm",
    y="PetalWidthCm",
    hue="Cluster",
    data=data,
    palette="Set1"
)

plt.scatter(
    kmeans.cluster_centers_[:, 2],
    kmeans.cluster_centers_[:, 3],
    s=300,
    marker="X",
    c="red",
    label="Centroids"
)

plt.xlabel("Petal Length")
plt.ylabel("Petal Width")
plt.title("K-Means Clustering")
plt.legend()
plt.show()

# 9. Define actual labels and encode them
y_true = data["Species"]

le = LabelEncoder()
y_encoded = le.fit_transform(y_true)

# 10. Map cluster labels to actual species labels
labels_mapped = np.zeros_like(y_kmeans)

for cluster in range(3):
    mask = (y_kmeans == cluster)
    labels_mapped[mask] = mode(
        y_encoded[mask], keepdims=True
    ).mode[0]

# 11. Calculate accuracy
accuracy = accuracy_score(y_encoded, labels_mapped)
print("K-Means Accuracy:", accuracy * 100, "%")

# 12. Display confusion matrix
cm = confusion_matrix(y_encoded, labels_mapped)

sns.heatmap(
    cm,
    annot=True,
    fmt="d",
    cmap="Blues",
    xticklabels=le.classes_,
    yticklabels=le.classes_
)

plt.title("Confusion Matrix - K-Means")
plt.xlabel("Predicted Labels")
plt.ylabel("True Labels")
plt.show()
